root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# Portal pages and assets, dashboard source and front-end config use 2 spaces
[{*.blade.php,*.html,*.css,*.js,*.mjs,*.ts,*.tsx,*.json}]
indent_size = 2

[composer.json]
indent_size = 4

[compose.yaml]
indent_size = 4
