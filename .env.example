APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Address the app is opened at (Herd: http://<folder>.test). Production: https://<domain>
APP_URL=http://portal-uptdkotakupang.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pintu
DB_USERNAME=
DB_PASSWORD=

# Local database that `composer test:mysql` may reset. Never point it at data
# you want to keep; leave empty to run tests on in-memory SQLite only.
DB_TEST_DATABASE=

# Login sessions: 8 hours without activity, ended when the browser closes unless
# "Ingat perangkat ini" is ticked (7 days). Laravel Cloud needs the database
# driver (its filesystem is ephemeral) and SESSION_SECURE_COOKIE=true.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Login throttling counts attempts in the cache, so every server must share
# one store: database (or Redis/Valkey). A file store counts per server and
# is emptied on every Laravel Cloud deploy.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser origins allowed to read the API, comma-separated and exact
# (scheme://host[:port]); wildcards, paths and trailing slashes are ignored.
# Leave empty to refuse all cross-origin browsers. The portal, dashboard and
# API share one origin, so PINTU itself needs none.
CORS_ALLOWED_ORIGINS=

PINTU_PUBLIC_API_REQUESTS_PER_MINUTE=300
PINTU_PUBLIC_FAQ_MAX_ITEMS=100
